{
  "name": "travelwebsite",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build --configuration production",
    "start": "ng serve",
    "start:prod": "ng serve --configuration production",
    "preview:prod": "npm run build && npm run serve:ssr:Travelwebsite",
    "preview:static": "npm run build && npx --yes serve dist/Travelwebsite/browser -l 4200 -c serve.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "optimize-images": "node scripts/optimize-images.mjs",
    "generate-image-manifest": "node scripts/generate-image-manifest.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-image-manifest.mjs && node scripts/generate-sitemap.mjs",
    "prestart": "node scripts/generate-image-manifest.mjs && node scripts/generate-sitemap.mjs",
    "serve:ssr:Travelwebsite": "node dist/Travelwebsite/server/server.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.1",
    "@angular/common": "20.3.1",
    "@angular/compiler": "20.3.1",
    "@angular/core": "20.3.1",
    "@angular/forms": "20.3.1",
    "@angular/platform-browser": "20.3.1",
    "@angular/platform-browser-dynamic": "20.3.1",
    "@angular/platform-server": "20.3.1",
    "@angular/router": "20.3.1",
    "@angular/ssr": "^20.3.21",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "animate.css": "^4.1.1",
    "body-parser": "^2.2.0",
    "bootstrap": "^4.6.2",
    "clarity-js": "^0.8.67",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jquery": "^3.7.1",
    "ngx-google-analytics": "^14.0.1",
    "ngx-toastr": "^19.1.0",
    "nodemailer": "^7.0.6",
    "owl.carousel": "^2.3.4",
    "rxjs": "~7.8.0",
    "schema-dts": "^2.0.0",
    "swiper": "^12.1.2",
    "tempusdominus": "^5.16.0",
    "tslib": "^2.3.0",
    "web-vitals": "^5.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.21",
    "@angular/cli": "20.3.1",
    "@angular/compiler-cli": "20.3.1",
    "@fontsource/poppins": "^5.2.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "baseline-browser-mapping": "^2.10.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.35.1",
    "typescript": "~5.8.2"
  },
  "description": "This project was generated using [Angular CLI](https://github.com/angular/angular-cli) version 20.1.1.",
